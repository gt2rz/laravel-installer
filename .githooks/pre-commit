#!/bin/sh

# Salir inmediatamente si un comando falla
set -e

# Colores para la terminal
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 ${YELLOW}Iniciando verificaciones de calidad y seguridad pre-commit...${NC}"

# --------------------------------------------------------
# 1. VALIDACIÓN DE ARCHIVOS PROHIBIDOS (.gitignore enforcement)
# --------------------------------------------------------
echo "🚫 ${YELLOW}Verificando archivos sensibles en el índice de Git...${NC}"
FORBIDDEN_FILES=$(git diff --cached --name-only \
  | grep -E "(\.env$|\.env\.(local|production|staging|testing|development|prod|dev)|id_rsa|.*\.pem|.*\.key)$" \
  || true)


if [ ! -z "$FORBIDDEN_FILES" ]; then
    echo "❌ ${RED}CRITICAL ERROR: Estás intentando subir archivos restringidos a Git:${NC}"
    echo "$FORBIDDEN_FILES"
    echo "⚠️ ${YELLOW}Solución: Ejecuta 'git rm --cached <archivo>' para removerlos del índice.${NC}"
    exit 1
fi

# --------------------------------------------------------
# 2. ESCÁNER DE SEGURIDAD: Detección de Secretos en Código
# --------------------------------------------------------
echo "🛡️ ${YELLOW}Escaneando archivos en busca de credenciales expuestas...${NC}"
SECRET_PATTERNS="(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA)[A-Z0-9]{16}|sk_live_[0-9a-zA-Z]{24}|gh[opsg]_[0-9a-zA-Z]{36}|(?i)(password|secret|passwd|db_password)\s*=\s*['\"].+['\"]"
SECRET_FOUND=$(git diff --cached --name-only | xargs grep -E "$SECRET_PATTERNS" || true)

if [ ! -z "$SECRET_FOUND" ]; then
    echo "❌ ${RED}CRITICAL SECURITY ERROR: Se detectaron posibles secretos expuestos:${NC}"
    echo "$SECRET_FOUND"
    exit 1
fi
echo "✅ ${GREEN}Seguridad de archivos y credenciales aprobada.${NC}"

# --------------------------------------------------------
# 3. CALIDAD DE CÓDIGO Y ESTILO (Laravel Pint & Larastan)
# --------------------------------------------------------
# Todo el tooling corre dentro del contenedor 'api' (vendor no existe en el host).
# Si el entorno no está levantado, se omiten estas verificaciones en vez de bloquear el commit.
if [ -z "$(docker compose -f docker-compose.dev.yml ps -q --status running api 2>/dev/null)" ]; then
    echo "⚠️  ${YELLOW}El contenedor 'api' no está corriendo. Se omiten Pint, Larastan y los tests.${NC}"
    echo "⚠️  ${YELLOW}Levanta el entorno con 'make up' para que estas verificaciones se ejecuten.${NC}"
    echo "🎉 ${GREEN}Creando el commit...${NC}"
    exit 0
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ ${GREEN}No hay archivos PHP modificados para analizar.${NC}"
else
    echo "🎨 ${YELLOW}Ejecutando Laravel Pint (Formateador)...${NC}"
    if ! docker compose -f docker-compose.dev.yml exec -T api ./vendor/bin/pint $STAGED_FILES; then
        echo "❌ ${RED}Error: Laravel Pint encontró problemas de estilo.${NC}"
        exit 1
    fi
    git add $STAGED_FILES

    echo "🧠 ${YELLOW}Ejecutando Larastan (Análisis Estático)...${NC}"
    if ! docker compose -f docker-compose.dev.yml exec -T api ./vendor/bin/phpstan analyze --memory-limit=1G --error-format=table; then
        echo "❌ ${RED}Error: Análisis estático fallido.${NC}"
        exit 1
    fi
    echo "✅ ${GREEN}Código limpio y estandarizado.${NC}"
fi

# --------------------------------------------------------
# 4. TESTING: Suite de Pruebas Unitaras y de Integración
# --------------------------------------------------------
echo "🧪 ${YELLOW}Ejecutando la suite de pruebas (PHPUnit/Pest)...${NC}"
if ! docker compose -f docker-compose.dev.yml exec -T api php artisan test --parallel; then
    echo "❌ ${RED}Error: Hay pruebas fallando en la aplicación.${NC}"
    exit 1
fi

echo "🎉 ${GREEN}¡Todo perfecto! Creando el commit...${NC}"
exit 0
